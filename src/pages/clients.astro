---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ClientCarousel from '../components/ClientCarousel.astro';
import { clients } from '../data/clients.js';

// Import all client logos dynamically
const logoModules = import.meta.glob('../assets/clients/*.{png,jpg,jpeg,svg}', { eager: true });
const logoMap = Object.fromEntries(
  Object.entries(logoModules).map(([path, module]) => {
    const filename = path.split('/').pop();
    return [filename, module.default];
  })
);

// Breadcrumb schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Clients' },
  ],
};

// Organization schema for each client
const clientSchemas = clients.map((client, idx) => ({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: client.name,
  description: client.description,
  ...(client.testimonial && {
    review: {
      '@type': 'Review',
      reviewRating: { '@type': 'Rating', ratingValue: 5 },
      reviewBody: client.testimonial,
      author: { '@type': 'Person', name: client.testimonialAuthor },
    },
  }),
}));
---

<BaseLayout
  title="Clients & Case Studies | Lex Corp"
  description="Companies that trust Lex Corp for cloud architecture, DevOps engineering, and infrastructure automation. View our case studies and proven customer results."
>
  <!-- Structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {clientSchemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
  <!-- ================= HERO ================= -->
  <section class="hero hero-clients">
    <div class="grid-bg"></div>
    <div class="container hero-in">
      <div class="hero-copy">
        <h1 class="h1">Trusted by industry leaders</h1>
        <p class="lead">
          Companies across sectors rely on Lex Corp for cloud infrastructure that scales,
          DevOps pipelines that ship faster, and security that holds.
        </p>
      </div>
    </div>
  </section>

  {clients.length === 0 ? (
    <section class="section clients-empty">
      <div class="container">
        <div class="glass-card">
          <Icon name="code" size={48} />
          <h2 class="h3">Client showcase coming soon</h2>
          <p>We're documenting our client case studies and will share them here shortly.</p>
        </div>
      </div>
    </section>
  ) : (
    <>
      <!-- ================= CLIENTS CAROUSEL ================= -->
      <section class="section clients-sec">
        <div class="container">
          <h2 class="section-head">Our clients</h2>
          <ClientCarousel clients={clients} logoMap={logoMap} />
        </div>
      </section>

      <!-- ================= STATS ================= -->
      <section class="section clients-stats">
        <div class="container">
          <div class="stats-grid">
            <div class="stat-card">
              <div class="stat-number">{clients.length}+</div>
              <div class="stat-label">Companies served</div>
            </div>
            <div class="stat-card">
              <div class="stat-number">98%</div>
              <div class="stat-label">Client satisfaction</div>
            </div>
            <div class="stat-card">
              <div class="stat-number">5+ yrs</div>
              <div class="stat-label">Average engagement</div>
            </div>
          </div>
        </div>
      </section>
    </>
  )}

  <!-- ================= CTA ================= -->
  <section class="section cta-sec">
    <div class="container">
      <div class="glass-card cta-card">
        <h2 class="h3">Ready to transform your infrastructure?</h2>
        <p class="lead">
          Join companies that have cut deployment times, reduced costs, and scaled reliably
          with Lex Corp's engineering partnership.
        </p>
        <a href="/contact" class="btn btn-primary">Start a project</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-clients {
    padding-block: clamp(60px, 8vw, 100px);
  }

  .hero-in {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 24px;
  }

  .hero-copy h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.2;
    max-width: 600px;
    font-weight: 800;
    letter-spacing: -0.5px;
  }

  .clients-empty {
    padding-block: clamp(80px, 10vw, 120px);
  }

  .clients-empty .glass-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(40px, 5vw, 60px);
    gap: 20px;
  }

  .clients-empty svg {
    color: var(--accent-blue);
    opacity: 0.6;
  }

  .clients-sec {
    padding-block: clamp(60px, 8vw, 100px);
  }

  .section-head {
    margin-bottom: clamp(40px, 5vw, 60px);
    font-size: clamp(1.6rem, 4vw, 2rem);
    text-align: center;
  }

  .clients-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(20px, 3vw, 32px);
  }

  .client-card {
    display: flex;
    flex-direction: column;
    padding: clamp(32px, 5vw, 48px);
    gap: 24px;
    border: 1px solid var(--border);
    transition: all 0.3s var(--ease-out);
  }

  .client-card:hover {
    border-color: var(--accent-blue);
    transform: translateY(-2px);
  }

  .client-logo {
    width: 100%;
    height: 140px;
    object-fit: contain;
    margin-bottom: 8px;
  }

  .client-logo-placeholder {
    width: 100%;
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    color: var(--text-muted);
    text-align: center;
    padding: 16px;
    font-weight: 600;
  }

  .client-card h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.3px;
  }

  .client-desc {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-soft);
    line-height: 1.6;
  }

  .achievements {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .achievement {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.9rem;
    color: var(--text-soft);
    line-height: 1.5;
  }

  .achievement svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--term-ok);
  }

  .testimonial {
    padding-top: 0;
    border-top: none;
  }

  .quote {
    margin: 0 0 12px;
    font-size: 0.95rem;
    font-style: italic;
    color: var(--text-soft);
    line-height: 1.7;
  }

  .author {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .clients-stats {
    padding-block: clamp(60px, 8vw, 100px);
    background: var(--bg-elev);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: clamp(32px, 5vw, 48px);
    text-align: center;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(32px, 4vw, 40px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .stat-number {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-weight: 800;
    color: var(--accent-blue);
    letter-spacing: -1px;
  }

  .stat-label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-soft);
  }

  .cta-sec {
    padding-block: clamp(60px, 8vw, 100px);
  }

  .cta-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(40px, 5vw, 60px);
    gap: 24px;
  }

  .cta-card h2 {
    margin: 0;
    max-width: 500px;
  }

  .cta-card .lead {
    max-width: 600px;
    margin: 0;
  }

  @media (max-width: 768px) {
    .clients-grid {
      grid-template-columns: 1fr;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
