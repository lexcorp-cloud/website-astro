---
import ToolLayout from '../../layouts/ToolLayout.astro';
import ScanForm from '../../components/ScanForm.astro';
import ScanResults from '../../components/ScanResults.astro';
import Icon from '../../components/Icon.astro';

const checks = [
  { icon: 'shield', name: 'SPF', desc: 'Which servers may send as your domain' },
  { icon: 'code', name: 'DKIM', desc: 'Cryptographic signing of outgoing mail' },
  { icon: 'mail', name: 'DMARC', desc: 'What receivers do when checks fail' },
  { icon: 'server', name: 'MX', desc: 'Where your inbound mail is handled' },
];
---

<ToolLayout
  slug="email-security"
  title="Free SPF, DKIM & DMARC Checker"
  description="Free SPF, DKIM and DMARC checker. See whether your domain can be spoofed, and get plain-English fixes. Runs entirely in your browser — no signup, nothing stored."
  heading="Can someone send email pretending to be you?"
  intro="Check any domain’s SPF, DKIM and DMARC configuration. Most domains are missing at least one — which is how phishing and invoice fraud get through."
>
  <ScanForm slot="input" cta="Scan domain" />

  <ScanResults />

  <section class="section explain-sec">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What gets checked</span>
        <h2 class="h2">Four records decide whether your domain can be spoofed.</h2>
      </div>

      <div class="grid grid-4">
        {checks.map((c) => (
          <div class="reveal glass-card ex">
            <span class="icon-tile"><Icon name={c.icon} /></span>
            <h3 class="h3">{c.name}</h3>
            <p>{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</ToolLayout>

<style>
  .explain-sec { padding-block: clamp(40px, 5vw, 72px); }
  .ex h3 { margin: 14px 0 6px; }
  .ex p { margin: 0; font-size: 0.88rem; color: var(--text-muted); }
</style>

<script>
  import { scanDomain } from '../../scripts/email-scan.js';
  import { wireScanner, findingCard, esc } from '../../scripts/tool-ui.js';

  wireScanner({
    scan: scanDomain,

    summarise: (r) =>
      r.score >= 90
        ? 'This domain is well protected against spoofing.'
        : r.score >= 60
          ? 'Partially protected — the gaps below still leave room for spoofing.'
          : 'This domain can likely be spoofed today. The failures below are worth fixing first.',

    render: (r) => {
      // DKIM and MX carry extra detail that does not fit the generic `record`
      // field, so they are folded in before rendering.
      const dkim = { ...r.dkim };
      if (r.dkim.selectors?.length) {
        dkim.record = r.dkim.selectors
          .map((s) => `${s.selector}._domainkey → ${s.record.slice(0, 90)}${s.record.length > 90 ? '…' : ''}`)
          .join('\n');
      }

      const mx = { ...r.mx };
      if (r.mx.hosts?.length) mx.record = r.mx.hosts.join('\n');

      return (
        findingCard('SPF — authorised senders', r.spf) +
        findingCard('DKIM — message signing', dkim) +
        findingCard('DMARC — enforcement policy', r.dmarc) +
        findingCard('MX — inbound mail', mx)
      );
    },
  });
</script>
