---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Icon from '../../components/Icon.astro';

// Grouped rather than four separate pages: individually these are too thin to
// rank or to justify a URL each, but together they make one page worth landing on.
const panels = [
  { id: 'base64', icon: 'code', name: 'Base64', desc: 'Encode and decode, UTF-8 safe' },
  { id: 'uuid', icon: 'bolt', name: 'UUID v4', desc: 'Cryptographically random identifiers' },
  { id: 'hash', icon: 'shield', name: 'SHA hash', desc: 'SHA-1, SHA-256, SHA-384, SHA-512' },
  { id: 'epoch', icon: 'clock', name: 'Unix time', desc: 'Timestamp ⇄ human date' },
];
---

<ToolLayout
  slug="dev-utilities"
  title="Developer Utilities — Base64, UUID, SHA Hash, Unix Time"
  description="Four everyday developer conversions in one page: Base64 encode and decode, UUID v4 generation, SHA-256 hashing and Unix timestamp conversion. Runs entirely in your browser."
  heading="Developer utilities"
  intro="The four conversions you reach for most often, in one place. Everything runs locally in your browser — nothing you paste here is transmitted or stored."
>
  <div slot="input" class="du-tabs" role="tablist" aria-label="Utilities">
    {panels.map((p, i) => (
      <button
        type="button"
        class:list={['du-tab', i === 0 && 'is-active']}
        role="tab"
        id={`tab-${p.id}`}
        aria-controls={`panel-${p.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        data-target={p.id}
      >
        <span class="du-tab-icon"><Icon name={p.icon} size={16} /></span>
        <span class="du-tab-text">
          <b>{p.name}</b>
          <i>{p.desc}</i>
        </span>
      </button>
    ))}
  </div>

  <section class="section du-sec">
    <div class="container">

      <!-- ---------------- Base64 ---------------- -->
      <div class="glass-card panel" id="panel-base64" role="tabpanel" aria-labelledby="tab-base64">
        <h2 class="h3 p-h">Base64 encode / decode</h2>
        <div class="io">
          <label class="io-field">
            <span class="io-label mono">Plain text</span>
            <textarea id="b64-plain" rows="5" placeholder="Hello, Lex Corp"></textarea>
          </label>
          <div class="io-mid">
            <button type="button" class="io-btn" id="b64-enc" title="Encode">
              <Icon name="arrow" size={16} />
            </button>
            <button type="button" class="io-btn io-rev" id="b64-dec" title="Decode">
              <Icon name="arrow" size={16} />
            </button>
          </div>
          <label class="io-field">
            <span class="io-label mono">Base64</span>
            <textarea id="b64-enc-out" rows="5" placeholder="SGVsbG8sIExleCBDb3Jw"></textarea>
          </label>
        </div>
        <p class="p-note" id="b64-note">Uses TextEncoder, so accented characters and emoji round-trip correctly — plain <code>btoa()</code> throws on them.</p>
      </div>

      <!-- ---------------- UUID ---------------- -->
      <div class="glass-card panel" id="panel-uuid" role="tabpanel" aria-labelledby="tab-uuid" hidden>
        <h2 class="h3 p-h">UUID v4 generator</h2>
        <div class="uuid-controls">
          <label class="mini-field">
            <span class="io-label mono">How many</span>
            <input type="number" id="uuid-count" value="5" min="1" max="100" />
          </label>
          <button type="button" class="btn btn-primary btn-sm" id="uuid-gen">Generate</button>
          <button type="button" class="btn btn-ghost btn-sm" id="uuid-copy">Copy all</button>
        </div>
        <pre class="out-block" id="uuid-out"></pre>
        <p class="p-note">Generated with <code>crypto.randomUUID()</code> where available — cryptographically random, not <code>Math.random()</code>.</p>
      </div>

      <!-- ---------------- Hash ---------------- -->
      <div class="glass-card panel" id="panel-hash" role="tabpanel" aria-labelledby="tab-hash" hidden>
        <h2 class="h3 p-h">SHA hash</h2>
        <label class="io-field">
          <span class="io-label mono">Input</span>
          <textarea id="hash-in" rows="4" placeholder="Text to hash"></textarea>
        </label>
        <div class="hash-algos" id="hash-out"></div>
        <p class="p-note">
          Computed with the Web Crypto API. <b>MD5 is deliberately absent</b> — browsers do not
          implement it, and it has been unsuitable for anything security-related for years.
        </p>
      </div>

      <!-- ---------------- Epoch ---------------- -->
      <div class="glass-card panel" id="panel-epoch" role="tabpanel" aria-labelledby="tab-epoch" hidden>
        <h2 class="h3 p-h">Unix timestamp converter</h2>
        <div class="io">
          <label class="io-field">
            <span class="io-label mono">Unix timestamp</span>
            <input type="text" id="ep-ts" placeholder="1767225600" />
          </label>
          <div class="io-mid"><span class="io-swap mono">⇄</span></div>
          <label class="io-field">
            <span class="io-label mono">Date &amp; time (local)</span>
            <input type="datetime-local" id="ep-date" step="1" />
          </label>
        </div>
        <dl class="rows" id="ep-rows"></dl>
        <div class="ep-now">
          <button type="button" class="btn btn-ghost btn-sm" id="ep-now-btn">Use current time</button>
          <span class="mono" id="ep-live"></span>
        </div>
      </div>
    </div>
  </section>
</ToolLayout>

<style>
  /* ---------- tabs ---------- */
  .du-tabs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 10px;
    margin-top: 26px;
    max-width: none;
  }

  .du-tab {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    text-align: left;
    transition: border-color 0.3s var(--ease-out), background-color 0.3s var(--ease-out);
  }

  .du-tab:hover { border-color: var(--border-strong); }

  .du-tab.is-active {
    border-color: var(--accent-blue);
    background: color-mix(in srgb, var(--accent-blue) 12%, transparent);
  }

  .du-tab-icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex: none;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: linear-gradient(150deg, rgba(108, 124, 255, 0.22), rgba(255, 77, 109, 0.12));
  }

  .du-tab-text { display: flex; flex-direction: column; min-width: 0; }
  .du-tab-text b { font-size: 0.85rem; font-weight: 570; }

  .du-tab-text i {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ---------- panels ---------- */
  .du-sec { padding-block: clamp(20px, 3vw, 36px); }
  .p-h { margin: 0 0 20px; padding-bottom: 14px; border-bottom: 1px solid var(--border); }

  .p-note {
    margin: 18px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--border);
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .p-note code,
  .p-note b { color: var(--text-soft); }

  .p-note code {
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--surface-strong);
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  /* ---------- shared io ---------- */
  .io {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 14px;
    align-items: center;
  }

  .io-field { display: flex; flex-direction: column; gap: 8px; min-width: 0; }

  .io-label { font-size: 0.6rem !important; color: var(--text-muted); }

  .io-field textarea,
  .io-field input,
  .mini-field input {
    width: 100%;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    resize: vertical;
    transition: border-color 0.25s var(--ease-out);
  }

  .io-field textarea:focus,
  .io-field input:focus,
  .mini-field input:focus { outline: none; border-color: var(--accent-blue); }

  .io-mid { display: flex; flex-direction: column; gap: 8px; align-items: center; }

  .io-btn {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-soft);
    cursor: pointer;
    transition: border-color 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }

  .io-btn:hover { border-color: var(--accent-blue); color: var(--text); }
  .io-rev svg { transform: rotate(180deg); }
  .io-swap { color: var(--text-muted); font-size: 1rem !important; }

  /* ---------- uuid ---------- */
  .uuid-controls { display: flex; align-items: flex-end; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
  .mini-field { display: flex; flex-direction: column; gap: 8px; width: 110px; }

  .out-block {
    margin: 0;
    padding: 14px 16px;
    border-radius: var(--radius-xs);
    background: var(--term-bg);
    border: 1px solid var(--term-border);
    color: var(--term-text);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.9;
    max-height: 260px;
    overflow: auto;
    white-space: pre-wrap;
    word-break: break-all;
  }

  /* ---------- hash ---------- */
  .hash-algos { display: grid; gap: 12px; margin-top: 18px; }

  .hash-algos > :global(div) {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    padding: 11px 14px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .hash-algos :global(.ha) {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--accent-blue);
  }

  .hash-algos :global(.hv) {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-soft);
    word-break: break-all;
  }

  /* ---------- epoch ---------- */
  .rows { margin: 20px 0 0; display: grid; }

  .rows > :global(div) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    padding: 11px 0;
    border-top: 1px dashed var(--border);
    font-size: 0.86rem;
  }

  .rows > :global(div:first-child) { border-top: 0; padding-top: 0; }
  .rows :global(dt) { color: var(--text-muted); flex: none; }

  .rows :global(dd) {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-align: right;
    word-break: break-word;
  }

  .ep-now {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .ep-now .mono { font-size: 0.66rem !important; color: var(--text-muted); }

  @media (max-width: 720px) {
    .io { grid-template-columns: minmax(0, 1fr); }
    .io-mid { flex-direction: row; }
    .io-rev svg { transform: rotate(90deg); }
    .io-btn svg { transform: rotate(90deg); }
  }
</style>

<script>
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;');

  /* ---------------- tabs ---------------- */
  const tabs = Array.from(document.querySelectorAll('.du-tab')) as HTMLElement[];
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.target;
      tabs.forEach((t) => {
        const on = t === tab;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', String(on));
        const panel = $(`panel-${t.dataset.target}`);
        if (panel) panel.hidden = !on;
      });
      if (target) location.replace(`#${target}`);
    });
  });

  // Open the panel named in the hash, so links can point at one utility.
  const hash = location.hash.replace('#', '');
  if (hash) tabs.find((t) => t.dataset.target === hash)?.click();

  /* ---------------- Base64 ---------------- */
  const b64Plain = $('b64-plain') as HTMLTextAreaElement;
  const b64Out = $('b64-enc-out') as HTMLTextAreaElement;
  const b64Note = $('b64-note');
  const defaultNote = b64Note?.innerHTML;

  // btoa/atob are byte-oriented, so anything non-ASCII must go through
  // TextEncoder first or it throws / mangles the result.
  const encodeB64 = (str) => btoa(String.fromCharCode(...new TextEncoder().encode(str)));
  const decodeB64 = (str) =>
    new TextDecoder().decode(Uint8Array.from(atob(str.replace(/\s+/g, '')), (c) => c.charCodeAt(0)));

  $('b64-enc')?.addEventListener('click', () => {
    try {
      b64Out.value = b64Plain.value ? encodeB64(b64Plain.value) : '';
      if (b64Note && defaultNote) b64Note.innerHTML = defaultNote;
    } catch {
      if (b64Note) b64Note.textContent = 'Could not encode that input.';
    }
  });

  $('b64-dec')?.addEventListener('click', () => {
    try {
      b64Plain.value = b64Out.value ? decodeB64(b64Out.value) : '';
      if (b64Note && defaultNote) b64Note.innerHTML = defaultNote;
    } catch {
      if (b64Note) b64Note.textContent = 'That is not valid Base64 — check for stray characters or truncation.';
    }
  });

  /* ---------------- UUID ---------------- */
  const uuid = () =>
    crypto.randomUUID
      ? crypto.randomUUID()
      : // Fallback: still crypto-random, just assembled manually.
        ([1e7] + -1e3 + -4e3 + -8e3 + -1e11).replace(/[018]/g, (c: any) =>
          (c ^ (crypto.getRandomValues(new Uint8Array(1))[0] & (15 >> (c / 4)))).toString(16)
        );

  const genUuids = () => {
    const n = Math.min(100, Math.max(1, Number(($('uuid-count') as HTMLInputElement).value) || 1));
    const out = $('uuid-out');
    if (out) out.textContent = Array.from({ length: n }, uuid).join('\n');
  };

  $('uuid-gen')?.addEventListener('click', genUuids);
  $('uuid-copy')?.addEventListener('click', async () => {
    const btn = $('uuid-copy');
    try {
      await navigator.clipboard.writeText($('uuid-out')?.textContent || '');
      if (btn) { btn.textContent = 'Copied'; setTimeout(() => (btn.textContent = 'Copy all'), 1600); }
    } catch { /* clipboard blocked */ }
  });
  genUuids();

  /* ---------------- Hash ---------------- */
  const ALGOS = ['SHA-1', 'SHA-256', 'SHA-384', 'SHA-512'];
  const hashIn = $('hash-in') as HTMLTextAreaElement;

  const toHex = (buf) =>
    Array.from(new Uint8Array(buf)).map((b) => b.toString(16).padStart(2, '0')).join('');

  async function doHash() {
    const out = $('hash-out');
    if (!out) return;
    const text = hashIn.value;
    if (!text) {
      out.innerHTML = ALGOS.map((a) => `<div><span class="ha">${a}</span><span class="hv">—</span></div>`).join('');
      return;
    }
    const data = new TextEncoder().encode(text);
    const results = await Promise.all(
      ALGOS.map(async (a) => `<div><span class="ha">${a}</span><span class="hv">${toHex(await crypto.subtle.digest(a, data))}</span></div>`)
    );
    out.innerHTML = results.join('');
  }

  hashIn?.addEventListener('input', doHash);
  doHash();

  /* ---------------- Epoch ---------------- */
  const tsInput = $('ep-ts') as HTMLInputElement;
  const dateInput = $('ep-date') as HTMLInputElement;

  const pad = (n) => String(n).padStart(2, '0');
  const toLocalInput = (d) =>
    `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;

  function renderEpoch(d) {
    const rows = $('ep-rows');
    if (!rows || Number.isNaN(d.getTime())) return;
    rows.innerHTML = [
      ['Unix seconds', Math.floor(d.getTime() / 1000)],
      ['Unix milliseconds', d.getTime()],
      ['ISO 8601 (UTC)', d.toISOString()],
      ['UTC', d.toUTCString()],
      ['Local', d.toString().replace(/\s\(.+\)$/, '')],
      ['Relative', relativeTime(d)],
    ]
      .map(([k, v]) => `<div><dt>${esc(k)}</dt><dd>${esc(v)}</dd></div>`)
      .join('');
  }

  function relativeTime(d) {
    const diff = d.getTime() - Date.now();
    const abs = Math.abs(diff);
    const units: [number, string][] = [
      [31536000000, 'year'], [2592000000, 'month'], [86400000, 'day'],
      [3600000, 'hour'], [60000, 'minute'], [1000, 'second'],
    ];
    for (const [ms, name] of units) {
      if (abs >= ms) {
        const n = Math.round(abs / ms);
        return `${n} ${name}${n === 1 ? '' : 's'} ${diff < 0 ? 'ago' : 'from now'}`;
      }
    }
    return 'now';
  }

  tsInput?.addEventListener('input', () => {
    const raw = tsInput.value.trim();
    if (!/^\d+$/.test(raw)) return;
    // Treat 13-digit values as milliseconds, 10-digit as seconds.
    const n = Number(raw);
    const d = new Date(raw.length > 10 ? n : n * 1000);
    dateInput.value = toLocalInput(d);
    renderEpoch(d);
  });

  dateInput?.addEventListener('input', () => {
    const d = new Date(dateInput.value);
    if (Number.isNaN(d.getTime())) return;
    tsInput.value = String(Math.floor(d.getTime() / 1000));
    renderEpoch(d);
  });

  $('ep-now-btn')?.addEventListener('click', () => {
    const d = new Date();
    tsInput.value = String(Math.floor(d.getTime() / 1000));
    dateInput.value = toLocalInput(d);
    renderEpoch(d);
  });

  // Seed with now, and keep a live clock so the page is never static.
  (() => {
    const d = new Date();
    tsInput.value = String(Math.floor(d.getTime() / 1000));
    dateInput.value = toLocalInput(d);
    renderEpoch(d);
    const live = $('ep-live');
    if (live) {
      const tick = () => { live.textContent = `Now: ${Math.floor(Date.now() / 1000)}`; };
      tick();
      setInterval(tick, 1000);
    }
  })();
</script>
