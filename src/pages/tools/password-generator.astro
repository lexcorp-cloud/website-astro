---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Icon from '../../components/Icon.astro';
---

<ToolLayout
  slug="password-generator"
  title="Password & Passphrase Generator"
  description="Generate cryptographically random passwords or passphrases in your browser, with real entropy in bits and an honest offline crack-time estimate. Nothing is transmitted or stored."
  heading="Generate a password you can actually justify"
  intro="Cryptographically random, generated locally, with the real entropy shown in bits rather than a vague “strong” badge. Nothing is sent anywhere or stored."
>
  <div slot="input" class="pw-input">
    <div class="pw-out glass-card">
      <output class="pw-value" id="pw-value" aria-live="polite">—</output>
      <div class="pw-out-actions">
        <button type="button" class="io-btn" id="pw-regen" aria-label="Generate another">
          <Icon name="transform" size={17} />
        </button>
        <button type="button" class="btn btn-primary btn-sm" id="pw-copy">Copy</button>
      </div>
    </div>

    <div class="pw-strength">
      <div class="pw-bar"><span id="pw-fill"></span></div>
      <div class="pw-meta">
        <span id="pw-verdict" class="pw-verdict">—</span>
        <span class="mono" id="pw-entropy">—</span>
      </div>
    </div>
  </div>

  <section class="section pw-sec">
    <div class="container">
      <div class="pw-grid">
        <div class="glass-card">
          <h2 class="h3 pw-h">Options</h2>

          <div class="mode-toggle" role="tablist">
            <button type="button" class="mode is-active" data-mode="random" role="tab" aria-selected="true">Random characters</button>
            <button type="button" class="mode" data-mode="phrase" role="tab" aria-selected="false">Passphrase</button>
          </div>

          <!-- random mode -->
          <div id="opts-random">
            <label class="range-row">
              <span>Length <b id="len-val">20</b></span>
              <input type="range" id="pw-len" min="8" max="64" value="20" />
            </label>

            <div class="checks">
              <label><input type="checkbox" id="c-lower" checked /> <span>Lowercase <code>a–z</code></span></label>
              <label><input type="checkbox" id="c-upper" checked /> <span>Uppercase <code>A–Z</code></span></label>
              <label><input type="checkbox" id="c-num" checked /> <span>Digits <code>0–9</code></span></label>
              <label><input type="checkbox" id="c-sym" checked /> <span>Symbols <code>!@#$…</code></span></label>
              <label><input type="checkbox" id="c-amb" /> <span>Exclude look-alikes <code>0O1lI</code></span></label>
            </div>
          </div>

          <!-- passphrase mode -->
          <div id="opts-phrase" hidden>
            <label class="range-row">
              <span>Words <b id="words-val">5</b></span>
              <input type="range" id="pw-words" min="3" max="10" value="5" />
            </label>

            <div class="checks">
              <label><input type="checkbox" id="p-cap" checked /> <span>Capitalise each word</span></label>
              <label><input type="checkbox" id="p-num" /> <span>Append a digit</span></label>
            </div>

            <label class="sep-row">
              <span class="io-label mono">Separator</span>
              <select id="p-sep">
                <option value="-">hyphen -</option>
                <option value=".">dot .</option>
                <option value="_">underscore _</option>
                <option value=" ">space</option>
              </select>
            </label>
          </div>
        </div>

        <div class="glass-card">
          <h2 class="h3 pw-h">What the numbers mean</h2>
          <dl class="rows" id="pw-rows"></dl>
        </div>
      </div>
    </div>
  </section>

  <section class="section pw-notes-sec">
    <div class="container">
      <div class="glass-card note">
        <span class="icon-tile"><Icon name="shield" /></span>
        <div>
          <h2 class="h3">How the crack-time figure is calculated</h2>
          <p>
            Entropy is <code>log₂(alphabet<sup>length</sup>)</code> for random
            characters, or <code>log₂(wordlist<sup>words</sup>)</code> for a
            passphrase &mdash; computed from the options you actually chose, not
            estimated from the output.
          </p>
          <p>
            The time assumes an <b>offline</b> attack at 100 billion guesses per
            second, roughly a well-funded GPU rig against a fast hash. Against a
            properly slow hash like bcrypt or Argon2 it would take vastly longer;
            against an unsalted MD5 dump, less. It is a yardstick, not a promise.
          </p>
          <p class="note-limit">
            Entropy only holds if the generator is genuinely random. This uses
            <code>crypto.getRandomValues()</code>, never <code>Math.random()</code>,
            and rejects modulo bias when mapping bytes to characters &mdash; a
            subtle flaw that quietly skews the distribution in many generators.
          </p>
        </div>
      </div>
    </div>
  </section>
</ToolLayout>

<style>
  .pw-input { margin-top: 26px; max-width: 46rem; }

  .pw-out {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding: clamp(20px, 3vw, 28px);
  }

  .pw-value {
    flex: 1;
    min-width: 200px;
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.4vw, 1.5rem);
    font-weight: 560;
    letter-spacing: 0.01em;
    word-break: break-all;
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .pw-out-actions { display: flex; align-items: center; gap: 10px; flex: none; }

  .io-btn {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-soft);
    cursor: pointer;
    transition: border-color 0.25s var(--ease-out), transform 0.35s var(--ease-out);
  }

  .io-btn:hover { border-color: var(--accent-blue); color: var(--text); transform: rotate(90deg); }

  .pw-strength { margin-top: 16px; }

  .pw-bar {
    height: 6px;
    border-radius: 3px;
    background: var(--surface-strong);
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .pw-bar span {
    display: block;
    height: 100%;
    width: 0%;
    border-radius: 3px;
    transition: width 0.4s var(--ease-out), background 0.4s var(--ease-out);
  }

  .pw-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    margin-top: 10px;
  }

  .pw-verdict { font-size: 0.88rem; font-weight: 560; }
  .pw-meta .mono { font-size: 0.66rem !important; color: var(--text-muted); }

  .pw-sec { padding-block: clamp(20px, 3vw, 36px); }

  .pw-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 16px;
  }

  .pw-h { margin: 0 0 18px; padding-bottom: 14px; border-bottom: 1px solid var(--border); }

  .mode-toggle {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 22px;
  }

  .mode {
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-soft);
    font-size: 0.84rem;
    cursor: pointer;
    transition: border-color 0.25s var(--ease-out), background-color 0.25s var(--ease-out);
  }

  .mode.is-active {
    border-color: var(--accent-blue);
    background: color-mix(in srgb, var(--accent-blue) 12%, transparent);
    color: var(--text);
  }

  .range-row { display: block; margin-bottom: 20px; }
  .range-row > span { display: block; font-size: 0.84rem; color: var(--text-soft); margin-bottom: 10px; }
  .range-row b { color: var(--accent-blue); font-family: var(--font-mono); }

  .range-row input[type='range'] {
    width: 100%;
    accent-color: var(--accent-blue);
  }

  .checks { display: grid; gap: 11px; }

  .checks label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.86rem;
    color: var(--text-soft);
    cursor: pointer;
  }

  .checks input { accent-color: var(--accent-blue); width: 16px; height: 16px; }

  .checks code {
    padding: 1px 6px;
    border-radius: 4px;
    background: var(--surface-strong);
    font-family: var(--font-mono);
    font-size: 0.78em;
    color: var(--text-muted);
  }

  .sep-row { display: flex; align-items: center; gap: 12px; margin-top: 18px; }
  .sep-row .io-label { font-size: 0.6rem !important; color: var(--text-muted); }

  .sep-row select {
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--text);
    font-size: 0.82rem;
    cursor: pointer;
  }

  .rows { margin: 0; display: grid; }

  .rows > :global(div) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    padding: 11px 0;
    border-top: 1px dashed var(--border);
    font-size: 0.87rem;
  }

  .rows > :global(div:first-child) { border-top: 0; padding-top: 0; }
  .rows :global(dt) { color: var(--text-muted); flex: none; }

  .rows :global(dd) {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-align: right;
  }

  .pw-notes-sec { background: var(--bg-elev); border-top: 1px solid var(--border); }
  .note { display: grid; grid-template-columns: 46px minmax(0, 1fr); gap: 18px; align-items: start; }
  .note h2 { margin-bottom: 12px; }
  .note p { margin: 0 0 10px; font-size: 0.9rem; color: var(--text-muted); line-height: 1.7; }
  .note p:last-child { margin-bottom: 0; }
  .note b { color: var(--text-soft); font-weight: 600; }
  .note-limit { padding-top: 12px; border-top: 1px solid var(--border); }

  .note code {
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--surface-strong);
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--text-soft);
  }

  @media (max-width: 560px) {
    .note { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;');

  const SETS = {
    lower: 'abcdefghijklmnopqrstuvwxyz',
    upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
    num: '0123456789',
    sym: '!@#$%^&*()-_=+[]{};:,.?/',
  };
  const AMBIGUOUS = '0O1lI|`';

  // A compact EFF-style list. Entropy is computed from its ACTUAL length, so a
  // shorter list honestly reports lower entropy rather than overclaiming.
  const WORDS = ('able acid aged also arch area army atom aunt away back bake bald band bank barn base bath bead beam bean bear beat beef bell belt bend best bike bill bind bird bite blend blue boat body boil bold bolt bond bone book boot bore born boss both bowl brag brave bread brick bring broad brown brush build bulk bull bump bunk burn bush bust busy cabin cable cage cake calm camp cane cape card care cargo cart case cash cast cave cell chain chair chalk charm chart chase cheap check chess chest chief child chill chip city civic claim clamp clash class clean clear clerk climb cloak clock cloth cloud clown club coach coast coat code coil coin cold colt comb come cook cool cope copy cord core cork corn cost couch cough count court cover crab craft crane crash crate crawl cream creek crew crib crop cross crowd crown crush cube cult curb cure curl curve cycle daily dairy dance dare dark dart dash data dawn deal dean dear debt deck deep deer delay dense depth desk dial diet dime dine dirt dish dive dock does dome done door dose dot dove down doze draft drag drain drama draw dream dress drift drill drink drive drop drum dry duck dust duty each earn ease east easy echo edge edit eels eggs eight elbow elder elite else empty ends enemy enjoy enter entry equal error essay even event ever every exact exam exist exit extra fable face fact fade fail faint fair faith fall false fancy farm fast fate fault favor fear feast fence fever field fifth fight file fill film final find fine fire firm first fish fist five fixed flag flame flash flat fleet flesh float flock flood floor flour flow fluid flush flute foam focus fold folk food fool foot force fork form fort forum found four frame fraud free fresh friend front frost fruit fuel full fund funny').split(/\s+/);

  let mode = 'random';

  /** Uniform selection without modulo bias — reject bytes in the unfair tail. */
  function pick(alphabet) {
    const n = alphabet.length;
    const max = Math.floor(256 / n) * n;
    const buf = new Uint8Array(1);
    let byte;
    do {
      crypto.getRandomValues(buf);
      byte = buf[0];
    } while (byte >= max);
    return alphabet[byte % n];
  }

  function randInt(maxExclusive) {
    const max = Math.floor(4294967296 / maxExclusive) * maxExclusive;
    const buf = new Uint32Array(1);
    let v;
    do {
      crypto.getRandomValues(buf);
      v = buf[0];
    } while (v >= max);
    return v % maxExclusive;
  }

  function buildAlphabet() {
    let alpha = '';
    if (($('c-lower') as HTMLInputElement).checked) alpha += SETS.lower;
    if (($('c-upper') as HTMLInputElement).checked) alpha += SETS.upper;
    if (($('c-num') as HTMLInputElement).checked) alpha += SETS.num;
    if (($('c-sym') as HTMLInputElement).checked) alpha += SETS.sym;
    if (($('c-amb') as HTMLInputElement).checked) {
      alpha = [...alpha].filter((c) => !AMBIGUOUS.includes(c)).join('');
    }
    return alpha;
  }

  function crackTime(bits) {
    // 1e11 guesses/sec ≈ a serious GPU rig against a fast hash.
    const seconds = 2 ** bits / 1e11;
    const units: [number, string][] = [
      [3.156e16, 'billion years'], [3.156e13, 'million years'], [3.156e7, 'years'],
      [2.628e6, 'months'], [86400, 'days'], [3600, 'hours'], [60, 'minutes'],
    ];
    for (const [s, name] of units) {
      if (seconds >= s) {
        const n = seconds / s;
        return `${n >= 100 ? Math.round(n).toLocaleString() : n.toFixed(1)} ${name}`;
      }
    }
    return seconds < 1 ? 'instantly' : `${Math.round(seconds)} seconds`;
  }

  function verdictFor(bits) {
    if (bits >= 128) return { label: 'Overkill (in a good way)', colour: 'var(--term-ok)', pct: 100 };
    if (bits >= 100) return { label: 'Excellent', colour: 'var(--term-ok)', pct: 88 };
    if (bits >= 75) return { label: 'Strong', colour: 'var(--term-ok)', pct: 70 };
    if (bits >= 60) return { label: 'Reasonable', colour: '#febc2e', pct: 52 };
    if (bits >= 40) return { label: 'Weak', colour: '#febc2e', pct: 32 };
    return { label: 'Very weak', colour: 'var(--accent-red)', pct: 14 };
  }

  function generate() {
    let value = '';
    let bits = 0;
    let detail: [string, string][] = [];

    if (mode === 'random') {
      const alpha = buildAlphabet();
      const len = Number(($('pw-len') as HTMLInputElement).value);

      if (!alpha.length) {
        $('pw-value')!.textContent = 'Select at least one character set';
        $('pw-fill')!.style.width = '0%';
        $('pw-verdict')!.textContent = '—';
        $('pw-entropy')!.textContent = '—';
        return;
      }

      value = Array.from({ length: len }, () => pick(alpha)).join('');
      bits = Math.log2(alpha.length) * len;
      detail = [
        ['Alphabet size', `${alpha.length} characters`],
        ['Length', `${len}`],
        ['Entropy', `${bits.toFixed(1)} bits`],
        ['Possible combinations', `~10^${Math.round(bits * Math.log10(2))}`],
        ['Offline crack time', crackTime(bits)],
      ];
    } else {
      const count = Number(($('pw-words') as HTMLInputElement).value);
      const sep = ($('p-sep') as HTMLSelectElement).value;
      const cap = ($('p-cap') as HTMLInputElement).checked;
      const addNum = ($('p-num') as HTMLInputElement).checked;

      const chosen = Array.from({ length: count }, () => WORDS[randInt(WORDS.length)]);
      const shaped = cap ? chosen.map((w) => w[0].toUpperCase() + w.slice(1)) : chosen;
      value = shaped.join(sep) + (addNum ? String(randInt(10)) : '');

      bits = Math.log2(WORDS.length) * count + (addNum ? Math.log2(10) : 0);
      detail = [
        ['Wordlist size', `${WORDS.length} words`],
        ['Words', `${count}`],
        ['Entropy', `${bits.toFixed(1)} bits`],
        ['Possible combinations', `~10^${Math.round(bits * Math.log10(2))}`],
        ['Offline crack time', crackTime(bits)],
      ];
    }

    $('pw-value')!.textContent = value;

    const v = verdictFor(bits);
    const fill = $('pw-fill')!;
    fill.style.width = `${v.pct}%`;
    fill.style.background = v.colour;
    const verdict = $('pw-verdict')!;
    verdict.textContent = v.label;
    verdict.style.color = v.colour;
    $('pw-entropy')!.textContent = `${bits.toFixed(1)} bits of entropy`;

    const rows = $('pw-rows');
    if (rows) {
      rows.innerHTML = detail.map(([k, val]) => `<div><dt>${esc(k)}</dt><dd>${esc(val)}</dd></div>`).join('');
    }
  }

  /* ---- wiring ---- */
  document.querySelectorAll('.mode').forEach((btn) => {
    btn.addEventListener('click', () => {
      mode = (btn as HTMLElement).dataset.mode || 'random';
      document.querySelectorAll('.mode').forEach((b) => {
        const on = b === btn;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-selected', String(on));
      });
      $('opts-random')!.hidden = mode !== 'random';
      $('opts-phrase')!.hidden = mode !== 'phrase';
      generate();
    });
  });

  $('pw-len')?.addEventListener('input', (e) => {
    $('len-val')!.textContent = (e.target as HTMLInputElement).value;
    generate();
  });

  $('pw-words')?.addEventListener('input', (e) => {
    $('words-val')!.textContent = (e.target as HTMLInputElement).value;
    generate();
  });

  ['c-lower', 'c-upper', 'c-num', 'c-sym', 'c-amb', 'p-cap', 'p-num', 'p-sep'].forEach((id) => {
    $(id)?.addEventListener('change', generate);
  });

  $('pw-regen')?.addEventListener('click', generate);

  $('pw-copy')?.addEventListener('click', async () => {
    const btn = $('pw-copy');
    try {
      await navigator.clipboard.writeText($('pw-value')?.textContent || '');
      if (btn) { btn.textContent = 'Copied'; setTimeout(() => (btn.textContent = 'Copy'), 1600); }
    } catch { /* clipboard blocked */ }
  });

  generate();
</script>
