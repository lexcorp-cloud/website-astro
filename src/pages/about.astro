---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import { whyLexCorp, process, stats } from '../data/services.js';
import { team } from '../data/team.js';
import { COMPANY, CONTACT } from '../config/site.js';

const mission = [
  'Deliver reliable and secure technology solutions.',
  'Build scalable software and cloud platforms.',
  'Provide exceptional consulting and managed IT services.',
];
---

<BaseLayout
  title="About Lex Corp — IT Company in Kathmandu"
  description="Lex Corp Pvt. Ltd. is a Nepal-based information technology company specializing in cloud computing, DevOps engineering, software development, AI, cybersecurity, and digital transformation."
>
  <section class="section a-hero">
    <div class="grid-bg"></div>
    <div class="orb orb-b a-orb" data-parallax="0.15"></div>

    <div class="container a-hero-in">
      <span class="eyebrow">About Lex Corp</span>
      <h1 class="a-title">A Nepal-based engineering company built around reliability.</h1>
      <p class="lead">
        {COMPANY.legalName} specializes in cloud computing, DevOps engineering,
        software development, artificial intelligence, cybersecurity, and digital
        transformation — delivered from Kathmandu to clients at home and abroad.
      </p>
    </div>
  </section>

  <section class="section a-vm-sec">
    <div class="container">
      <div class="a-vm">
        <div class="reveal glass-card a-card">
          <span class="icon-tile"><Icon name="globe" /></span>
          <span class="eyebrow a-eb">Vision</span>
          <p class="a-statement">
            To become a leading technology company delivering innovative cloud, AI,
            and digital infrastructure solutions.
          </p>
        </div>

        <div class="reveal glass-card a-card">
          <span class="icon-tile"><Icon name="route" /></span>
          <span class="eyebrow a-eb">Mission</span>
          <ul class="a-mission">
            {mission.map((m) => (
              <li>
                <span class="tick"><Icon name="check" size={13} /></span>
                {m}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section a-stats-sec">
    <div class="container">
      <div class="grid grid-4">
        {stats.map((s) => (
          <div class="reveal stat glass-card">
            <span class="stat-value" data-counter={s.value} data-counter-suffix={s.suffix}>0{s.suffix}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section a-team-sec">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">The team</span>
        <h2 class="h2">Who you&rsquo;ll actually be working with.</h2>
        <p class="lead">
          Engagements are delivered by the people you meet &mdash; not passed to
          someone you never speak to.
        </p>
      </div>

      <div class="a-team">
        {team.map((person) => (
          <article class="reveal glass-card person">
            <div class="person-photo">
              <Image
                src={person.photo}
                alt={`${person.name}, ${person.role} at Lex Corp`}
                widths={[280, 560]}
                sizes="(max-width: 720px) 100vw, 280px"
                loading="lazy"
              />
            </div>

            <div class="person-body">
              <h3 class="h3">{person.name}</h3>
              <span class="person-role mono">{person.role}</span>

              <ul class="person-focus">
                {person.focus.map((f) => <li>{f}</li>)}
              </ul>

              <p>{person.bio}</p>

              {person.credentials.length > 0 && (
                <ul class="person-creds">
                  {person.credentials.map((c) => (
                    <li><span class="tick"><Icon name="check" size={13} /></span>{c}</li>
                  ))}
                </ul>
              )}

              <div class="person-links">
                <a href={person.linkedin} target="_blank" rel="noopener noreferrer">
                  <Icon name="linkedin" size={16} /> LinkedIn
                </a>
                <a href={person.email}>
                  <Icon name="mail" size={16} /> Email
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section a-proc-sec">
    <div class="scanline"></div>
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">How we work</span>
        <h2 class="h2">A blueprint before a single resource is provisioned.</h2>
        <p class="lead">
          The same four phases run on every engagement, whether it is a single
          migration or a full platform rebuild.
        </p>
      </div>

      <div class="a-proc">
        {process.map((p) => (
          <div class="reveal glass-card a-step">
            <span class="a-step-num">{p.step}</span>
            <h3 class="h3">{p.title}</h3>
            <p>{p.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section a-why-sec">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Why teams choose us</span>
        <h2 class="h2">What sets the delivery apart.</h2>
      </div>

      <div class="a-why">
        {whyLexCorp.map((w) => (
          <div class="reveal glass-card a-w">
            <span class="icon-tile"><Icon name={w.icon} /></span>
            <h3 class="h3">{w.title}</h3>
            <p>{w.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section a-cta-sec">
    <div class="container">
      <div class="cta-card reveal">
        <div class="grid-bg"></div>
        <div class="cta-in">
          <span class="eyebrow">Work with us</span>
          <h2 class="h2">Let&rsquo;s talk about your platform.</h2>
          <p class="lead">
            Reach out directly at <a class="a-link" href={CONTACT.emailHref}>{CONTACT.email}</a>,
            or send the details through the contact form.
          </p>
          <div class="cta-actions">
            <a href="/contact" class="btn btn-primary">
              Contact Lex Corp
              <span class="arrow"><Icon name="arrow" size={17} /></span>
            </a>
            <a href="/services" class="btn btn-ghost">See capabilities</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .a-hero {
    position: relative;
    padding-top: clamp(64px, 9vw, 108px);
    padding-bottom: clamp(40px, 5vw, 64px);
    overflow: hidden;
  }

  .a-orb { width: 520px; height: 520px; top: -220px; left: -160px; opacity: 0.28; }

  /* Also a .container — narrowing its max-width would re-centre the block. */
  .a-hero-in {
    position: relative;
    z-index: 1;
  }

  .a-hero-in > * {
    max-width: 46rem;
  }

  .a-title {
    margin-bottom: 20px;
    font-size: clamp(2.1rem, 4.6vw, 3.3rem);
    background: var(--gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .a-vm-sec { padding-top: clamp(24px, 3vw, 40px); }

  .a-vm {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .a-card { padding: clamp(26px, 3vw, 36px); }
  .a-eb { margin: 18px 0 12px; }

  .a-statement {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .a-mission {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 13px;
  }

  .a-mission li {
    display: grid;
    grid-template-columns: 20px 1fr;
    align-items: start;
    gap: 12px;
    font-size: 0.94rem;
    color: var(--text-soft);
    line-height: 1.55;
  }

  .tick {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin-top: 2px;
    border-radius: 50%;
    background: rgba(110, 231, 160, 0.12);
    border: 1px solid rgba(110, 231, 160, 0.3);
    color: var(--term-ok);
  }

  .a-stats-sec { padding-block: clamp(40px, 5vw, 64px); }
  .stat { text-align: center; }

  /* ---------- team ---------- */
  /* auto-fit so a second hire needs a registry entry and nothing else */
  .a-team {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 18px;
  }

  .person {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: clamp(20px, 3vw, 32px);
    align-items: start;
  }

  .person-photo {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--border);
  }

  /* Deliberately NOT using mix-blend-mode here. Blending a portrait into the
     brand gradient tints the face, which looks stylised at best and unflattering
     at worst — the wrong trade for a founder headshot, where looking like a real
     person matters more than matching the palette. The white studio background
     is softened with a vignette instead, so it sits on the dark card without
     recolouring the subject. */
  .person-photo :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .person-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 78% 78% at 50% 42%, transparent 55%, rgba(5, 6, 11, 0.42) 100%),
      linear-gradient(to bottom, transparent 60%, rgba(5, 6, 11, 0.3) 100%);
  }

  :root[data-theme='light'] .person-photo::after { display: none; }

  .person:hover .person-photo :global(img) { transform: scale(1.03); }

  @media (prefers-reduced-motion: reduce) {
    .person:hover .person-photo :global(img) { transform: none; }
  }

  .person-body h3 { margin: 0 0 6px; }

  .person-role {
    display: block;
    font-size: 0.66rem !important;
    color: var(--accent-blue);
    margin-bottom: 16px;
  }

  .person-focus {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 16px;
    padding: 0;
  }

  .person-focus li {
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--surface-strong);
    font-size: 0.72rem;
    color: var(--text-soft);
  }

  .person-body p {
    margin: 0 0 16px;
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .person-creds {
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
    display: grid;
    gap: 9px;
  }

  .person-creds li {
    display: grid;
    grid-template-columns: 20px 1fr;
    align-items: start;
    gap: 11px;
    font-size: 0.88rem;
    color: var(--text-soft);
  }

  .person-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .person-links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 15px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.82rem;
    color: var(--text-soft);
    transition: border-color 0.3s var(--ease-out), color 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }

  .person-links a:hover {
    border-color: var(--accent-blue);
    color: var(--text);
    transform: translateY(-2px);
  }

  @media (max-width: 620px) {
    .person { grid-template-columns: minmax(0, 1fr); }
    .person-photo { max-width: 220px; }
  }

  .a-proc-sec {
    position: relative;
    overflow: hidden;
    background: var(--bg-elev);
    border-block: 1px solid var(--border);
  }

  .a-proc {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .a-step-num {
    display: block;
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    color: var(--accent-blue);
  }

  .a-step h3 { margin-bottom: 8px; }

  .a-step p,
  .a-w p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .a-why {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .a-w h3 { margin: 16px 0 8px; }

  .a-link {
    color: var(--accent-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cta-card {
    position: relative;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-strong);
    background:
      radial-gradient(ellipse 70% 90% at 12% 8%, rgba(255, 77, 109, 0.16), transparent 62%),
      radial-gradient(ellipse 80% 90% at 88% 92%, rgba(108, 124, 255, 0.2), transparent 62%),
      var(--bg-elev);
    padding: clamp(36px, 5vw, 70px);
    overflow: hidden;
    text-align: center;
  }

  .cta-in {
    position: relative;
    z-index: 1;
    max-width: 600px;
    margin-inline: auto;
  }

  .cta-in .lead { margin-inline: auto; }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 13px;
    margin-top: 28px;
  }

  @media (max-width: 1000px) {
    .a-proc { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .a-why { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 720px) {
    .a-vm,
    .a-proc,
    .a-why { grid-template-columns: minmax(0, 1fr); }
  }
</style>
