---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const resources = [
  {
    title: 'Slashplus Case Study',
    description: 'See how we architected infrastructure migration for Vehicle Tracking, Digital Signage, and Waste Management systems. Includes zero-downtime deployment strategy and cost optimization results.',
    icon: 'code',
    cta: 'Download PDF',
    pdf: '/case-studies/slashplus-case-study.pdf',
  },
  {
    title: 'GadgetByte Nepal Case Study',
    description: 'Learn how we reduced cloud costs by 40-45% while building CI/CD pipelines for automated deployments. Complete technical implementation breakdown.',
    icon: 'pipeline',
    cta: 'Download PDF',
    pdf: '/case-studies/gadgetbyte-case-study.pdf',
  },
  {
    title: 'Team Automation Case Study',
    description: 'Discover our approach to designing scalable cloud architecture with disaster recovery planning and deployment automation blueprints.',
    icon: 'server',
    cta: 'Download PDF',
    pdf: '/case-studies/team-automation-case-study.pdf',
  },
  {
    title: 'GBN Store Case Study',
    description: 'Enterprise-grade e-commerce infrastructure on Next.js with microservices, multi-node deployment, automated CI/CD, security hardening, and disaster recovery.',
    icon: 'shopping-cart',
    cta: 'Download PDF',
    pdf: '/case-studies/gbnstore-case-study.pdf',
  },
];
---

<BaseLayout
  title="Resources & Case Studies"
  description="Download cloud architecture case studies, DevOps guides, and infrastructure automation resources from Lex Corp."
>
  <!-- ================= HERO ================= -->
  <section class="section hero-resources">
    <div class="container hero-in">
      <div class="hero-copy">
        <h1>Resources & Insights</h1>
        <p class="lead">
          Deep-dive case studies, technical guides, and proven strategies from our cloud infrastructure engagements. Download resources to learn how we helped companies scale reliably and reduce costs.
        </p>
      </div>
    </div>
  </section>

  <!-- ================= RESOURCES GRID ================= -->
  <section class="section resources-sec">
    <div class="container">
      <div class="resources-grid">
        {resources.map((resource, idx) => (
          <div class="resource-card glass-card">
            <div class="resource-icon">
              <Icon name={resource.icon} size={32} />
            </div>
            <h3 class="resource-title">{resource.title}</h3>
            <p class="resource-desc">{resource.description}</p>
            <button
              class="btn btn-primary resource-cta"
              onclick={`openDownloadModal('${resource.pdf}', '${resource.title}')`}
              title={`Download ${resource.title}`}
            >
              {resource.cta}
              <span class="arrow"><Icon name="arrow" size={14} /></span>
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= DOWNLOAD MODAL ================= -->
  <div class="modal" id="download-modal">
    <div class="modal-backdrop" onclick="closeDownloadModal()"></div>
    <div class="modal-content">
      <button class="modal-close" onclick="closeDownloadModal()" aria-label="Close modal">
        <Icon name="close" size={24} />
      </button>
      <h2 class="modal-title">Download Case Study</h2>
      <p class="modal-subtitle">Enter your email to download the case study PDF</p>

      <form id="download-form" class="download-form">
        <input type="hidden" name="access_key" value="e5a55154-1d88-41b1-82dc-b47f36fea64d" />
        <input type="hidden" id="pdf-url" name="pdf_url" value="" />
        <input type="hidden" id="pdf-title" name="pdf_title" value="" />

        <div class="form-group">
          <label for="email">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="your@email.com"
            required
          />
        </div>

        <div class="form-group">
          <label for="company">Company (Optional)</label>
          <input
            type="text"
            id="company"
            name="company"
            placeholder="Your company name"
          />
        </div>

        <button type="submit" class="btn btn-primary btn-block">
          Download PDF
        </button>
      </form>

      <p class="modal-note">We respect your privacy. Your email will only be used for resources updates.</p>
    </div>
  </div>

  <!-- ================= CTA ================= -->
  <section class="section cta-sec">
    <div class="container">
      <div class="glass-card cta-card">
        <h2 class="h3">Need custom resources for your use case?</h2>
        <p class="lead">
          Our team creates tailored documentation, architecture diagrams, and implementation guides for specific technology stacks and business requirements.
        </p>
        <a href="/contact" class="btn btn-primary">Request Custom Resources</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-resources {
    padding-block: clamp(60px, 8vw, 100px);
  }

  .hero-in {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 24px;
  }

  .hero-copy h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -0.5px;
    max-width: 600px;
  }

  .resources-sec {
    padding-block: clamp(60px, 8vw, 100px);
  }

  .resources-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(20px, 3vw, 32px);
  }

  .resource-card {
    display: flex;
    flex-direction: column;
    padding: clamp(32px, 5vw, 48px);
    gap: 20px;
    border: 1px solid var(--border);
    transition: all 0.3s var(--ease-out);
  }

  .resource-card:hover {
    border-color: var(--accent-blue);
    transform: translateY(-2px);
  }

  .resource-icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 123, 255, 0.1);
    border-radius: var(--radius-md);
    color: var(--accent-blue);
  }

  .resource-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    margin: 0;
  }

  .resource-desc {
    font-size: 0.95rem;
    color: var(--text-soft);
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .resource-cta {
    align-self: flex-start;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .cta-sec {
    padding-block: clamp(60px, 8vw, 100px);
  }

  .cta-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(40px, 5vw, 60px);
    gap: 24px;
  }

  .cta-card h2 {
    margin: 0;
    max-width: 500px;
  }

  .cta-card .lead {
    max-width: 600px;
    margin: 0;
  }

  .modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 20px;
  }

  .modal[hidden] {
    display: none !important;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    cursor: pointer;
  }

  .modal-content {
    position: relative;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(32px, 5vw, 48px);
    max-width: 450px;
    width: 100%;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    animation: slideUp 0.3s ease-out;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--text-soft);
    transition: color 0.2s;
  }

  .modal-close:hover {
    color: var(--text);
  }

  .modal-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 8px 0;
  }

  .modal-subtitle {
    font-size: 0.95rem;
    color: var(--text-soft);
    margin: 0 0 24px 0;
  }

  .download-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 24px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
  }

  .form-group input {
    padding: 12px 16px;
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text);
    font-size: 0.95rem;
    transition: all 0.2s;
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.1);
  }

  .form-group input::placeholder {
    color: var(--text-muted);
  }

  .btn-block {
    width: 100%;
  }

  .modal-note {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0;
    text-align: center;
  }

  .modal-loading {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: center;
  }

  .modal-success {
    text-align: center;
    color: var(--term-ok);
  }

  .modal-error {
    text-align: center;
    color: var(--term-error);
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .resources-grid {
      grid-template-columns: 1fr;
    }

    .modal-content {
      max-width: 100%;
      padding: 32px 24px;
    }

    .modal-title {
      font-size: 1.25rem;
    }
  }
</style>

<script>
  let pendingPdfUrl = '';
  let pendingPdfTitle = '';

  function openDownloadModal(pdfUrl, pdfTitle) {
    const modal = document.getElementById('download-modal');
    const form = document.getElementById('download-form');
    const pdfUrlInput = document.getElementById('pdf-url');
    const pdfTitleInput = document.getElementById('pdf-title');

    pendingPdfUrl = pdfUrl;
    pendingPdfTitle = pdfTitle;

    pdfUrlInput.value = pdfUrl;
    pdfTitleInput.value = pdfTitle;

    form.innerHTML = `
      <div class="form-group">
        <label for="email">Email Address</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="your@email.com"
          required
        />
      </div>

      <div class="form-group">
        <label for="company">Company (Optional)</label>
        <input
          type="text"
          id="company"
          name="company"
          placeholder="Your company name"
        />
      </div>

      <button type="submit" class="btn btn-primary btn-block">
        Download PDF
      </button>
    `;

    form.onsubmit = (e) => handleDownloadSubmit(e);

    modal.removeAttribute('hidden');
  }

  function closeDownloadModal() {
    const modal = document.getElementById('download-modal');
    modal.setAttribute('hidden', '');
    pendingPdfUrl = '';
    pendingPdfTitle = '';
  }

  async function handleDownloadSubmit(event) {
    event.preventDefault();

    const form = document.getElementById('download-form');
    const email = document.getElementById('email').value;
    const company = document.getElementById('company').value;
    const submitBtn = form.querySelector('button[type="submit"]');
    const originalText = submitBtn.textContent;

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="modal-loading">Submitting...</span>';

    try {
      const formData = new FormData();
      formData.append('access_key', 'e5a55154-1d88-41b1-82dc-b47f36fea64d');
      formData.append('email', email);
      formData.append('company', company);
      formData.append('pdf_title', pendingPdfTitle);
      formData.append('subject', `Case Study Download: ${pendingPdfTitle}`);

      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData,
      });

      if (response.ok) {
        submitBtn.innerHTML = '<span class="modal-success">✓ Success! Starting download...</span>';

        setTimeout(() => {
          const a = document.createElement('a');
          a.href = pendingPdfUrl;
          a.download = pendingPdfTitle + '.pdf';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);

          setTimeout(() => closeDownloadModal(), 500);
        }, 500);
      } else {
        throw new Error('Submission failed');
      }
    } catch (error) {
      submitBtn.disabled = false;
      submitBtn.innerHTML =
        '<span class="modal-error">Failed to submit. Please try again.</span>';
      setTimeout(() => {
        submitBtn.innerHTML = originalText;
      }, 3000);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('download-form');
    if (form) {
      form.onsubmit = (e) => handleDownloadSubmit(e);
    }
  });
</script>
