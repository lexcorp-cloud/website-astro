---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { services, technologies } from '../data/services.js';

const marquee = [...technologies, ...technologies];
---

<BaseLayout
  title="Services"
  description="Cloud engineering, DevOps automation, server infrastructure, software development, applied AI, cybersecurity, digital transformation, and managed services from Lex Corp."
>
  <section class="section s-hero">
    <div class="grid-bg"></div>
    <div class="orb orb-a s-orb" data-parallax="0.14"></div>

    <div class="container s-hero-in">
      <span class="eyebrow">Capabilities</span>
      <h1 class="s-title">Everything needed to build, run, and secure your platform.</h1>
      <p class="lead">
        Eight connected domains delivered by one team — so your architecture,
        pipelines, security posture, and support model are designed to fit together
        instead of fighting each other.
      </p>
      <div class="s-cta">
        <a href="/contact" class="btn btn-primary">
          Discuss your project
          <span class="arrow"><Icon name="arrow" size={17} /></span>
        </a>
      </div>
    </div>
  </section>

  <section class="strip">
    <div class="marquee">
      <div class="marquee-track">{marquee.map((t) => <span>{t}</span>)}</div>
    </div>
  </section>

  <section class="section s-list-sec">
    <div class="container">
      <div class="s-list">
        {services.map((s, i) => (
          <article id={s.slug} class="reveal glass-card s-card">
            <div class="s-card-head">
              <span class="icon-tile"><Icon name={s.icon} /></span>
              <span class="s-num mono">{String(i + 1).padStart(2, '0')}</span>
            </div>

            <h2 class="h3">{s.title}</h2>
            <p class="s-blurb">{s.blurb}</p>

            <ul class="s-bullets">
              {s.bullets.map((b) => (
                <li>
                  <span class="tick"><Icon name="check" size={13} /></span>
                  {b}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section s-cta-sec">
    <div class="container">
      <div class="cta-card reveal">
        <div class="grid-bg"></div>
        <div class="cta-in">
          <span class="eyebrow">Not sure where to start?</span>
          <h2 class="h2">We&rsquo;ll recommend the right entry point.</h2>
          <p class="lead">
            Most engagements begin with an assessment: we review what you run today,
            then propose the highest-leverage change first.
          </p>
          <div class="cta-actions">
            <a href="/contact" class="btn btn-primary">
              Book an assessment
              <span class="arrow"><Icon name="arrow" size={17} /></span>
            </a>
            <a href="/about" class="btn btn-ghost">About Lex Corp</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .s-hero {
    position: relative;
    padding-top: clamp(64px, 9vw, 108px);
    padding-bottom: clamp(48px, 6vw, 76px);
    overflow: hidden;
  }

  .s-orb { width: 560px; height: 560px; top: -240px; right: -160px; opacity: 0.3; }

  /* NB: this element is also .container, which centres itself via auto margins.
     Narrowing its max-width would re-centre the whole block and pull the copy
     out of alignment with the cards below — constrain the children instead. */
  .s-hero-in {
    position: relative;
    z-index: 1;
  }

  .s-hero-in > * {
    max-width: 46rem;
  }

  .s-title {
    margin-bottom: 20px;
    font-size: clamp(2.1rem, 4.6vw, 3.4rem);
    background: var(--gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .s-cta { margin-top: 30px; }

  .strip {
    padding: 24px 0;
    border-block: 1px solid var(--border);
    background: var(--bg-elev);
  }

  .s-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .s-card { scroll-margin-top: 120px; }

  .s-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .s-num {
    font-size: 0.66rem;
    color: var(--text-muted);
    opacity: 0.6;
  }

  .s-card h2 { margin-bottom: 10px; }

  .s-blurb {
    margin-bottom: 20px;
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .s-bullets {
    list-style: none;
    margin: 0;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    display: grid;
    gap: 11px;
  }

  .s-bullets li {
    display: grid;
    grid-template-columns: 20px 1fr;
    align-items: center;
    gap: 11px;
    font-size: 0.88rem;
    color: var(--text-soft);
  }

  .tick {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(110, 231, 160, 0.12);
    border: 1px solid rgba(110, 231, 160, 0.3);
    color: var(--term-ok);
  }

  /* ---------- shared CTA card ---------- */
  .cta-card {
    position: relative;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-strong);
    background:
      radial-gradient(ellipse 70% 90% at 12% 8%, rgba(255, 77, 109, 0.16), transparent 62%),
      radial-gradient(ellipse 80% 90% at 88% 92%, rgba(108, 124, 255, 0.2), transparent 62%),
      var(--bg-elev);
    padding: clamp(36px, 5vw, 70px);
    overflow: hidden;
    text-align: center;
  }

  .cta-in {
    position: relative;
    z-index: 1;
    max-width: 600px;
    margin-inline: auto;
  }

  .cta-in .lead { margin-inline: auto; }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 13px;
    margin-top: 28px;
  }

  @media (max-width: 820px) {
    .s-list { grid-template-columns: minmax(0, 1fr); }
  }
</style>
