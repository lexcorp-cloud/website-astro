---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { CONTACT, COMPANY, ANALYTICS_ID, CLARITY_ID } from '../config/site.js';

// Written from what the site actually does, not from a template. If a service
// is added or removed, update this page in the same change.
const lastUpdated = 'August 2026';

const summary = [
  { icon: 'shield', title: 'No accounts', text: 'There is nothing to sign up for, and we hold no passwords.' },
  { icon: 'bolt', title: 'Tools run locally', text: 'Every free tool runs in your browser. The domains you check are never sent to us.' },
  { icon: 'check', title: 'Nothing sold', text: 'We do not sell, rent or trade personal data. Ever.' },
];
---

<BaseLayout
  title="Privacy Policy"
  description="How Lex Corp handles data on lexcorp.com.np — analytics, session recording, contact form submissions, and the third-party services our free tools use."
>
  <section class="section p-hero">
    <div class="grid-bg"></div>
    <div class="container p-in">
      <span class="eyebrow">Legal</span>
      <h1 class="p-title">Privacy Policy</h1>
      <p class="lead">
        What we collect on this website, why, and who else sees it. Written to be
        read rather than to cover us.
      </p>
      <p class="p-updated mono">Last updated: {lastUpdated}</p>
    </div>
  </section>

  <section class="section p-summary-sec">
    <div class="container">
      <div class="grid grid-3">
        {summary.map((s) => (
          <div class="reveal glass-card sm">
            <span class="icon-tile"><Icon name={s.icon} /></span>
            <h2 class="h3">{s.title}</h2>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section p-body-sec">
    <div class="container p-body">
      <h2 class="h2">Who we are</h2>
      <p>
        This website is operated by <b>{COMPANY.legalName}</b>, a company
        registered in Nepal and based in Kathmandu. For anything in this policy,
        contact us at <a href={CONTACT.emailHref}>{CONTACT.email}</a>.
      </p>

      <h2 class="h2">What we collect</h2>

      <h3 class="h3">When you submit the contact form</h3>
      <p>
        We receive the name, email address, optional company name and message you
        type. That is used solely to reply to your enquiry. Submissions are
        delivered by <b>Web3Forms</b>, which processes them on our behalf, and are
        protected from spam by <b>hCaptcha</b> (a Cloudflare service). We keep the
        resulting email correspondence for as long as needed to serve you, and you
        can ask us to delete it at any time.
      </p>

      {ANALYTICS_ID && (
        <>
          <h3 class="h3">Analytics</h3>
          <p>
            We use <b>Google Analytics 4</b> to understand which pages people find
            useful — pages viewed, approximate location, device and browser type,
            and how visitors arrived. It sets cookies and processes a truncated
            form of your IP address. We use it in aggregate; we do not attempt to
            identify individual visitors.
          </p>
        </>
      )}

      {CLARITY_ID && (
        <>
          <h3 class="h3">Session recording and heatmaps</h3>
          <p>
            We use <b>Microsoft Clarity</b>, which records how pages are used —
            mouse movement, scrolling, clicks and page transitions — and aggregates
            it into heatmaps and playback. This exists so we can find layout and
            usability problems, not to observe individuals.
          </p>
          <p>
            <b>Text you type is masked by default.</b> Clarity is configured so
            that input fields, including everything in our contact form, are
            obscured before any recording leaves your browser. We do not see your
            keystrokes.
          </p>
          <p>
            If you would rather not be recorded, enabling
            <b> Do Not Track</b> in your browser, or any standard tracker blocker,
            will stop both Clarity and Analytics from loading.
          </p>
        </>
      )}

      <h3 class="h3">Our free tools</h3>
      <p>
        The tools under <a href="/tools">/tools</a> deliberately have no backend.
        Every lookup runs in your own browser, and the domain you enter is never
        transmitted to us or stored anywhere on our side. To do their job, your
        browser talks directly to these third parties:
      </p>
      <ul class="p-list">
        <li><b>Cloudflare DNS</b> (<code>cloudflare-dns.com</code>) — DNS, SPF, DKIM, DMARC and DNSSEC lookups</li>
        <li><b>crt.sh</b> — public Certificate Transparency records for the SSL checker</li>
        <li><b>ipapi.co</b> and <b>ipify</b> — IP geolocation for the IP tool</li>
        <li><b>Cloudflare Speed</b> (<code>speed.cloudflare.com</code>) — download and upload measurement</li>
      </ul>
      <p>
        Those requests come from your browser, so each service sees your IP address
        under its own privacy policy. The downtime cost calculator makes no network
        requests at all.
      </p>

      <h3 class="h3">Hosting and logs</h3>
      <p>
        The site is hosted by <b>Vercel</b>, which keeps standard server logs
        including IP addresses for security and reliability.
      </p>

      <h2 class="h2">Cookies and local storage</h2>
      <p>
        We store one preference on your device: your choice of dark or light theme,
        kept in <code>localStorage</code> so the site does not flash the wrong
        colours on your next visit. It contains nothing identifying and never
        leaves your browser. Analytics and session-recording cookies are set by
        the services named above.
      </p>

      <h2 class="h2">Your rights</h2>
      <p>
        You can ask us what personal data we hold about you, request a correction
        or deletion, or object to our use of it. Write to
        <a href={CONTACT.emailHref}> {CONTACT.email}</a> and we will respond within
        30 days. If you are in the UK or EU, you also have the right to complain to
        your local data protection authority.
      </p>

      <h2 class="h2">Children</h2>
      <p>
        This is a business-to-business website and is not directed at children
        under 16. We do not knowingly collect their data.
      </p>

      <h2 class="h2">Changes</h2>
      <p>
        If we add or remove a service that handles data, this page is updated in the
        same change, and the date at the top will tell you when that last happened.
      </p>

      <div class="p-note glass-card">
        <span class="icon-tile"><Icon name="pin" /></span>
        <p>
          Questions about any of this, or want your data removed? Email
          <a href={CONTACT.emailHref}> {CONTACT.email}</a> and a person will reply.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .p-hero {
    position: relative;
    padding-top: clamp(64px, 9vw, 100px);
    padding-bottom: clamp(28px, 4vw, 44px);
    overflow: hidden;
  }

  .p-in { position: relative; z-index: 1; }
  .p-in > * { max-width: 44rem; }

  .p-title {
    margin-bottom: 16px;
    font-size: clamp(2.1rem, 4.4vw, 3rem);
    background: var(--gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .p-updated {
    margin-top: 18px;
    font-size: 0.62rem !important;
    color: var(--text-muted);
    letter-spacing: 0.1em;
  }

  .p-summary-sec { padding-block: clamp(20px, 3vw, 36px); }
  .sm h2 { margin: 14px 0 6px; }
  .sm p { margin: 0; font-size: 0.88rem; color: var(--text-muted); }

  /* ---------- prose ---------- */
  .p-body-sec { padding-top: clamp(24px, 4vw, 48px); }

  .p-body { max-width: 46rem; }

  .p-body .h2 {
    margin: clamp(34px, 4vw, 48px) 0 14px;
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }

  .p-body .h2:first-child { margin-top: 0; }

  .p-body .h3 {
    margin: 26px 0 10px;
    font-size: 1.02rem;
    color: var(--text);
  }

  .p-body p {
    margin: 0 0 14px;
    font-size: 0.94rem;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .p-body b { color: var(--text-soft); font-weight: 600; }

  .p-body a {
    color: var(--accent-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .p-body code {
    padding: 2px 6px;
    border-radius: 5px;
    background: var(--surface-strong);
    font-family: var(--font-mono);
    font-size: 0.84em;
    color: var(--text-soft);
  }

  .p-list {
    margin: 0 0 16px;
    padding-left: 20px;
    display: grid;
    gap: 9px;
  }

  .p-list li {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .p-note {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr);
    gap: 18px;
    align-items: center;
    margin-top: clamp(34px, 4vw, 48px);
  }

  .p-note p { margin: 0; }

  @media (max-width: 560px) {
    .p-note { grid-template-columns: minmax(0, 1fr); }
  }
</style>
