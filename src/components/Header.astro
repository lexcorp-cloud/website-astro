---
import { Image } from 'astro:assets';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import logoWhite from '../assets/logo-white-horizontal.png';
import logoBlack from '../assets/logo-black-horizontal.png';

const links = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/tools', label: 'Tools' },
  { href: '/about', label: 'About' },
  { href: '/team', label: 'Team' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
// Section links stay highlighted on their child pages (e.g. /tools/email-security).
const isCurrent = (href: string) => {
  if (href === '/') return path === '/';
  const base = href.replace(/\/+$/, '');
  return path === base || path.startsWith(`${base}/`);
};
---

<header class="hdr" id="site-header">
  <div class="container hdr-in">
    <a href="/" class="brand" aria-label="Lex Corp — home">
      <Image src={logoWhite} alt="Lex Corp" class="logo dark-only" widths={[220, 440]} sizes="220px" loading="eager" />
      <Image src={logoBlack} alt="Lex Corp" class="logo light-only" widths={[220, 440]} sizes="220px" loading="eager" />
    </a>

    <nav class="nav" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} class="nav-link" aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="actions">
      <ThemeToggle />
      <a href="/contact" class="btn btn-primary btn-sm cta">
        Start a project
        <span class="arrow"><Icon name="arrow" size={16} /></span>
      </a>
      <button id="menu-btn" class="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="drawer">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="hdr-line"></div>
</header>

<div class="drawer" id="drawer" hidden>
  <nav aria-label="Mobile">
    {links.map((l, i) => (
      <a href={l.href} style={`--d:${i * 55}ms`}>
        <span>{l.label}</span>
        <Icon name="arrow" size={18} />
      </a>
    ))}
  </nav>
  <a href="/contact" class="btn btn-primary btn-block drawer-cta">Start a project</a>
</div>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 100;
    background: transparent;
    transition: background-color 0.4s var(--ease-out), backdrop-filter 0.4s var(--ease-out);
  }

  /* frosted only once the page scrolls — the hero stays fully cinematic at rest */
  .hdr.is-stuck {
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
  }

  .hdr-line {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong) 20%, var(--border-strong) 80%, transparent);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
  }

  .hdr.is-stuck .hdr-line { opacity: 1; }

  .hdr-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    height: 76px;
  }

  .brand { display: flex; align-items: center; flex: none; }
  .logo { height: 30px; width: auto; }

  .dark-only, .light-only { display: none; }
  :root[data-theme='dark'] .dark-only { display: block; }
  :root[data-theme='light'] .light-only { display: block; }

  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 5px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--surface);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .nav-link {
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    font-size: 0.9rem;
    font-weight: 520;
    color: var(--text-muted);
    transition: color 0.3s var(--ease-out), background-color 0.3s var(--ease-out);
  }

  .nav-link:hover { color: var(--text); }

  .nav-link[aria-current='page'] {
    color: var(--text);
    background: var(--surface-strong);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .burger {
    display: none;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--surface);
    cursor: pointer;
  }

  .burger span {
    display: block;
    width: 17px;
    height: 1.6px;
    margin: 2.6px auto;
    border-radius: 2px;
    background: var(--text);
    transition: transform 0.35s var(--ease-out);
  }

  /* bar centres sit 6.8px apart (1.6 height + 2.6 margin each side), so each
     needs to travel half that to meet in the middle and form a clean X */
  .burger[aria-expanded='true'] span:first-child { transform: translateY(3.4px) rotate(45deg); }
  .burger[aria-expanded='true'] span:last-child { transform: translateY(-3.4px) rotate(-45deg); }

  /* ---------- mobile drawer ---------- */
  .drawer {
    position: fixed;
    inset: 76px 0 0;
    z-index: 99;
    padding: 26px var(--gutter) 40px;
    background: color-mix(in srgb, var(--bg) 96%, transparent);
    backdrop-filter: blur(26px);
    -webkit-backdrop-filter: blur(26px);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .drawer[hidden] { display: none; }

  .drawer nav { display: flex; flex-direction: column; }

  .drawer nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 4px;
    border-bottom: 1px solid var(--border);
    font-size: 1.35rem;
    font-weight: 560;
    letter-spacing: -0.02em;
    color: var(--text);
    opacity: 0;
    transform: translateY(14px);
    animation: drawer-in 0.5s var(--ease-out) forwards;
    animation-delay: var(--d);
  }

  .drawer nav a svg { color: var(--text-muted); }

  .drawer-cta {
    margin-top: 28px;
    opacity: 0;
    animation: drawer-in 0.5s var(--ease-out) 0.26s forwards;
  }

  @keyframes drawer-in {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 940px) {
    .nav, .cta { display: none; }
    .burger { display: grid; }
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer nav a,
    .drawer-cta { animation: none; opacity: 1; transform: none; }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('menu-btn');
  const drawer = document.getElementById('drawer');

  const onScroll = () => header?.classList.toggle('is-stuck', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!drawer || !btn) return;
    drawer.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.style.overflow = open ? 'hidden' : '';
  };

  btn?.addEventListener('click', () => setOpen(drawer?.hidden ?? true));
  drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && !drawer.hidden) setOpen(false);
  });

  window.matchMedia('(min-width: 941px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
