---
---

<button id="theme-toggle" class="tt" type="button" aria-label="Switch between dark and light theme">
  <span class="tt-icons">
    <svg class="ic sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2.6v2M12 19.4v2M4.5 4.5l1.4 1.4M18.1 18.1l1.4 1.4M2.6 12h2M19.4 12h2M4.5 19.5l1.4-1.4M18.1 5.9l1.4-1.4"></path>
    </svg>
    <svg class="ic moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
    </svg>
  </span>
</button>

<style>
  .tt {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--surface);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: var(--text);
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }

  .tt:hover {
    border-color: var(--accent-blue);
    box-shadow: 0 8px 26px -12px var(--glow-a);
  }

  .tt-icons {
    position: relative;
    display: grid;
    place-items: center;
    width: 19px;
    height: 19px;
  }

  .ic {
    position: absolute;
    width: 19px;
    height: 19px;
    transition: transform 0.45s var(--ease-out), opacity 0.35s var(--ease-out);
  }

  /* dark theme → offer the sun; light theme → offer the moon */
  :root[data-theme='dark'] .moon { transform: rotate(-70deg) scale(0.4); opacity: 0; }
  :root[data-theme='dark'] .sun { transform: none; opacity: 1; }
  :root[data-theme='light'] .sun { transform: rotate(70deg) scale(0.4); opacity: 0; }
  :root[data-theme='light'] .moon { transform: none; opacity: 1; }
</style>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', next);
    localStorage.setItem('lexcorp-theme', next);
  });
</script>
