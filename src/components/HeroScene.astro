---
---

<div class="scene" aria-hidden="true">
  <canvas id="hero-canvas"></canvas>
  <div class="scene-vignette"></div>
</div>

<style>
  .scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .scene canvas {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.4s var(--ease-out);
  }

  .scene canvas[data-ready='true'] {
    opacity: 1;
  }

  /* keeps text legible over the brightest part of the topology */
  .scene-vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 52% 62% at 18% 46%, var(--bg) 8%, transparent 68%),
      linear-gradient(to bottom, transparent 62%, var(--bg) 100%);
  }

  @media (max-width: 960px) {
    .scene-vignette {
      background: linear-gradient(to bottom, rgba(5, 6, 11, 0.45) 0%, transparent 34%, var(--bg) 100%);
    }

    :root[data-theme='light'] .scene-vignette {
      background: linear-gradient(to bottom, rgba(247, 248, 252, 0.5) 0%, transparent 34%, var(--bg) 100%);
    }
  }
</style>

<script>
  // Three.js is heavy, so it is fetched only once the hero is actually on
  // screen and the browser is idle — first paint stays fast.
  const canvas = document.getElementById('hero-canvas');

  if (canvas) {
    let started = false;

    const start = async () => {
      if (started) return;
      started = true;
      try {
        const { initHeroScene } = await import('../scripts/hero-scene.js');
        initHeroScene(canvas);
      } catch (err) {
        // A failed 3D layer must never break the page.
        canvas.remove();
      }
    };

    const boot = () => {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(start, { timeout: 1200 });
      } else {
        setTimeout(start, 200);
      }
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          boot();
        }
      }, { rootMargin: '200px' });
      io.observe(canvas);
    } else {
      boot();
    }
  }
</script>
