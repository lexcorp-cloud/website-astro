---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  clients: any[];
  logoMap: any;
}

const { clients, logoMap } = Astro.props;
---

<div class="carousel-container">
  <div class="carousel">
    <div class="carousel-track" id="carousel-track">
      {clients.map((client) => {
        const logo = logoMap[client.logo];
        return (
          <div class="carousel-slide glass-card" key={client.name}>
            <div class="slide-content">
              {logo ? (
                <Image
                  src={logo}
                  alt={client.name}
                  class="client-logo"
                  widths={[150, 300]}
                  sizes="150px"
                />
              ) : (
                <div class="client-logo-placeholder">{client.name}</div>
              )}

              <div class="client-info">
                <h3 class="h3">{client.name}</h3>
                <p class="client-desc">{client.description}</p>

                {client.achievements && client.achievements.length > 0 && (
                  <div class="achievements">
                    <h4>Key Achievements</h4>
                    <ul>
                      {client.achievements.map((achievement) => (
                        <li key={achievement}>
                          <Icon name="check" size={16} />
                          <span>{achievement}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {client.testimonial && (
                  <div class="testimonial">
                    <p class="quote">"{client.testimonial}"</p>
                    <p class="author">— {client.testimonialAuthor}</p>
                  </div>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Controls -->
  <div class="carousel-controls">
    <button class="carousel-btn prev" id="carousel-prev" aria-label="Previous client">
      <Icon name="arrow" size={20} />
    </button>

    <div class="carousel-indicators">
      {clients.map((_, idx) => (
        <button
          class={`indicator ${idx === 0 ? 'active' : ''}`}
          data-index={idx}
          aria-label={`Go to client ${idx + 1}`}
          key={idx}
        />
      ))}
    </div>

    <button class="carousel-btn next" id="carousel-next" aria-label="Next client">
      <Icon name="arrow" size={20} />
    </button>
  </div>

  <p class="carousel-counter"><span id="carousel-current">1</span> of {clients.length}</p>
</div>

<script>
  let currentIndex = 0;
  let autoSlideInterval: any = null;
  const track = document.getElementById('carousel-track');
  const slides = document.querySelectorAll('.carousel-slide');
  const prevBtn = document.getElementById('carousel-prev');
  const nextBtn = document.getElementById('carousel-next');
  const indicators = document.querySelectorAll('.indicator');
  const currentCounter = document.getElementById('carousel-current');
  const totalSlides = slides.length;
  const AUTO_SLIDE_INTERVAL = 6000; // 6 seconds

  function updateCarousel() {
    const offset = -currentIndex * 100;
    if (track) track.style.transform = `translateX(${offset}%)`;

    // Update indicators
    indicators.forEach((indicator, idx) => {
      indicator.classList.toggle('active', idx === currentIndex);
    });

    // Update counter
    if (currentCounter) currentCounter.textContent = currentIndex + 1;
  }

  function nextSlide() {
    currentIndex = (currentIndex + 1) % totalSlides;
    updateCarousel();
    resetAutoSlide();
  }

  function prevSlide() {
    currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
    updateCarousel();
    resetAutoSlide();
  }

  function goToSlide(index: number) {
    currentIndex = index;
    updateCarousel();
    resetAutoSlide();
  }

  function startAutoSlide() {
    autoSlideInterval = setInterval(() => {
      currentIndex = (currentIndex + 1) % totalSlides;
      updateCarousel();
    }, AUTO_SLIDE_INTERVAL);
  }

  function resetAutoSlide() {
    clearInterval(autoSlideInterval);
    startAutoSlide();
  }

  if (prevBtn) prevBtn.addEventListener('click', prevSlide);
  if (nextBtn) nextBtn.addEventListener('click', nextSlide);

  indicators.forEach((indicator) => {
    indicator.addEventListener('click', (e) => {
      const index = parseInt((e.target as HTMLElement).getAttribute('data-index') || '0');
      goToSlide(index);
    });
  });

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') prevSlide();
    if (e.key === 'ArrowRight') nextSlide();
  });

  // Start auto-slide
  startAutoSlide();

  // Pause auto-slide on hover
  const carouselContainer = document.querySelector('.carousel-container');
  if (carouselContainer) {
    carouselContainer.addEventListener('mouseenter', () => {
      clearInterval(autoSlideInterval);
    });
    carouselContainer.addEventListener('mouseleave', () => {
      startAutoSlide();
    });
  }
</script>

<style>
  .carousel-container {
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: center;
    will-change: transform;
  }

  .carousel {
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--bg);
  }

  .carousel-track {
    display: flex;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  .carousel-slide {
    flex: 0 0 100%;
    min-width: 100%;
    padding: clamp(40px, 6vw, 56px);
    animation: slideIn 0.6s ease-out;
  }

  @keyframes slideIn {
    from {
      opacity: 0.8;
    }
    to {
      opacity: 1;
    }
  }

  .slide-content {
    display: flex;
    gap: clamp(28px, 6vw, 48px);
    align-items: flex-start;
  }

  .client-logo {
    width: clamp(110px, 22vw, 180px);
    height: auto;
    flex-shrink: 0;
    object-fit: contain;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.1));
  }

  .client-logo-placeholder {
    width: clamp(110px, 22vw, 180px);
    height: 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    border-radius: var(--radius-md);
    font-weight: 700;
    font-size: 1.1rem;
    flex-shrink: 0;
    color: var(--text-soft);
  }

  .client-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }

  .client-info h3 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.5rem, 4vw, 2rem);
    line-height: 1.2;
  }

  .client-desc {
    color: var(--text-soft);
    line-height: 1.7;
    margin: 0;
    font-size: 0.95rem;
  }

  .achievements {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .achievements h4 {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .achievements ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .achievements li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 0.9rem;
    color: var(--text-soft);
    line-height: 1.5;
  }

  .achievements :global(svg) {
    flex-shrink: 0;
    color: var(--accent-blue);
    margin-top: 3px;
    min-width: 16px;
  }

  .testimonial {
    background: var(--surface);
    padding: 18px;
    border-radius: var(--radius-md);
    border-left: 4px solid var(--accent-blue);
    margin-top: 12px;
  }

  .quote {
    font-size: 0.9rem;
    font-style: italic;
    color: var(--text-soft);
    margin: 0 0 10px 0;
    line-height: 1.7;
  }

  .author {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
    font-weight: 600;
  }

  .carousel-controls {
    display: flex;
    align-items: center;
    gap: 28px;
    justify-content: center;
  }

  .carousel-btn {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    color: var(--text);
    font-weight: 600;
  }

  .carousel-btn:hover {
    background: var(--surface-strong);
    border-color: var(--accent-blue);
    color: var(--accent-blue);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0, 123, 255, 0.2);
  }

  .carousel-btn:active {
    transform: translateY(0);
  }

  .carousel-btn.prev :global(svg) {
    transform: rotate(180deg);
  }

  .carousel-indicators {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--surface);
    border: 1.5px solid var(--border);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 0;
  }

  .indicator:hover {
    background: var(--surface-strong);
  }

  .indicator.active {
    background: var(--accent-blue);
    border-color: var(--accent-blue);
    width: 28px;
    border-radius: 4px;
  }

  .carousel-counter {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .carousel-container {
      gap: 24px;
    }

    .carousel-slide {
      padding: clamp(28px, 5vw, 40px);
    }

    .slide-content {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: clamp(20px, 4vw, 28px);
    }

    .client-logo,
    .client-logo-placeholder {
      width: 100px;
      height: 100px;
    }

    .client-info h3 {
      font-size: 1.3rem;
    }

    .achievements li {
      font-size: 0.85rem;
      justify-content: center;
    }

    .carousel-controls {
      gap: 16px;
    }

    .carousel-btn {
      width: 40px;
      height: 40px;
    }

    .carousel-indicators {
      gap: 6px;
    }

    .indicator.active {
      width: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track,
    .carousel-slide,
    .carousel-btn {
      transition: none;
      animation: none;
    }
  }
</style>
