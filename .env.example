# Web3Forms access key for the contact form (free key from https://web3forms.com)
PUBLIC_WEB3FORMS_ACCESS_KEY=

# Canonical production site URL used for canonical tags, OG tags, and the sitemap.
# Leave blank on Vercel preview deployments - it falls back to the auto-provided VERCEL_URL.
PUBLIC_SITE_URL=https://www.lexcorp.com.np

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable analytics.
PUBLIC_ANALYTICS_ID=

# Microsoft Clarity project ID (session recordings + heatmaps). Leave blank to disable.
PUBLIC_CLARITY_ID=
