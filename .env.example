# Environment variables for Lex Corp website
# Copy this file to .env and fill in your values

# Web3Forms - Contact form submission handler
# Get your access key from https://www.web3forms.com
PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_key_here

# Google Analytics 4 - Website traffic and user behavior
# Get your measurement ID from Google Analytics
PUBLIC_ANALYTICS_ID=G-XXXXXXXXXX

# Microsoft Clarity - Session recordings and heatmaps
# Get your project ID from https://clarity.microsoft.com
PUBLIC_CLARITY_ID=your_clarity_id_here

# Drift - Live chat widget for customer support
# Get your workspace ID from https://www.drift.com (Settings → Installation)
# Leave empty to disable live chat
PUBLIC_DRIFT_ID=your_drift_id_here

# Site URL - Used for canonical URLs, sitemaps, and Open Graph
# Defaults to https://www.lexcorp.com.np if not set
# On Vercel, automatically uses VERCEL_URL if this is not set
PUBLIC_SITE_URL=https://www.lexcorp.com.np
